# Supabase > Project Settings > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# 화면에 보일 정보
NEXT_PUBLIC_FARM_NAME=OO농장
NEXT_PUBLIC_BANK_INFO=농협 000-0000-0000-00 (예금주 홍길동)
NEXT_PUBLIC_PRIVACY_RETENTION=발송 완료 후 6개월

# 롯데택배 엑셀의 보내는 사람 주소 (농장 주소로 고정. 보내는 사람 이름·연락처는 주문자로 나감)
NEXT_PUBLIC_SENDER_ADDRESS=제주특별자치도 서귀포시 ...
